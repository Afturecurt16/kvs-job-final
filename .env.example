# MAX bot (leave blank for a local Mini App-only run)
MAX_BOT_TOKEN=
MAX_ADMIN_IDS=
ADMIN_EMAIL=253103@edu.fa.ru
MAX_REQUIRED_CHANNEL_ID=0
MAX_REQUIRED_CHANNEL_URL=
MAX_API_BASE_URL=https://platform-api2.max.ru

# PostgreSQL. Docker Compose connects the application to its postgres service.
DB_HOST=localhost
DB_PORT=15432
DB_NAME=kvs_bot
DB_USER=postgres
DB_PASSWORD=postgres

# Mini App
MINIAPP_ENABLED=true
MINIAPP_HOST=0.0.0.0
MINIAPP_PORT=8000
MINIAPP_PUBLIC_URL=http://localhost:8000/miniapp
MINIAPP_DEV_ADMIN_ENABLED=false
EVENT_REMINDERS_ENABLED=true
EVENT_REMINDER_POLL_SECONDS=60

# Optional Google Sheets integration. Do not commit credentials.json.
GOOGLE_SHEETS_URL=
EVENTS_GOOGLE_SHEETS_URL=
GOOGLE_SHEET_NAME=
GOOGLE_CREDENTIALS_FILE=credentials.json

# Scheduled vacancy synchronisation
VACANCY_SYNC_SCHEDULE_ENABLED=true
VACANCY_SYNC_HOUR=0
VACANCY_SYNC_MINUTE=0
VACANCY_SYNC_TIMEZONE=Europe/Moscow
VACANCY_SYNC_ALLOW_EMPTY=false
SEED_DEMO_DATA=false
